# ============================================================
# KV Events Agent - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# DO NOT COMMIT .env to git - it's in .gitignore.
#
# All variables below are OPTIONAL. The app starts and runs without
# any of them; some scraping features are disabled until you set them.
# ============================================================

# ------------------------------------------------------------
# Instagram scraping (provider-agnostic backend)
# ------------------------------------------------------------
# IG_BACKEND selects the provider. Valid values:
#   apify     - cheapest free tier ($5/mo credit), uses apify/instagram-profile-scraper
#   hikerapi  - cheapest pay-as-you-go ($0.0006/request, no monthly fee)
#   disabled  - turn off Instagram scraping entirely
IG_BACKEND=disabled

# Required when IG_BACKEND=apify. Get one at https://console.apify.com/account/integrations
# Format: starts with "apify_" prefix followed by an alphanumeric token
APIFY_TOKEN=

# Required when IG_BACKEND=hikerapi. Get one at https://hikerapi.com
HIKERAPI_KEY=

# ------------------------------------------------------------
# Vision-LLM flyer extractor
# ------------------------------------------------------------
# LLM_PROVIDER selects which provider to call when an IG post needs
# image-based event extraction. Valid values:
#   gemini    - default, ~$0.0001 per image (Gemini 2.0 Flash)
#   openai    - ~$0.001 per image (gpt-4o-mini)
#   disabled  - skip LLM, fall back to caption regex (lower recall)
LLM_PROVIDER=disabled

# Required when LLM_PROVIDER=gemini. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Required when LLM_PROVIDER=openai. https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# Eventbrite / Luma (existing, unused - scrapers use public HTML)
# ------------------------------------------------------------
# EVENTBRITE_API_KEY=
# LUMA_API_KEY=
